# すべて任意。未設定でもデモモードで動作します。
# このファイルを .env という名前でコピーすると、起動時に自動で読み込まれます。
# (.env は .gitignore 済みです)

# SlackワークフローのWebhookトリガーURL。未設定なら通知は /inbox/:secret に溜まります
# SLACK_WEBHOOK_URL=

# 各URLの合言葉(既定: demo)
# APP_SECRET=demo

# 通知内リンクの生成に使うベースURL(末尾スラッシュなし)
# BASE_URL=https://your-app.example.com

# データ保存先(既定: ./data)
# DATA_DIR=./data

# PORT=3000
