{
  "id": "construction",
  "name": "建設 / 施工計画書の承認",
  "summary": "工事1件ごとの施工計画を、現場代理人から順に承認します。請負金額が大きい工事と、高所・重機を使う工事では通る人が変わります。",
  "slaDays": 5,
  "terms": {
    "request": "施工計画",
    "subject": "工事名",
    "counterparty": "発注者",
    "body": "施工計画の要旨"
  },
  "fields": [
    {
      "key": "amount",
      "label": "請負金額(万円)",
      "type": "number",
      "required": true,
      "placeholder": "3200"
    },
    {
      "key": "risk",
      "label": "高所・重機作業",
      "type": "select",
      "options": [
        "なし",
        "あり"
      ],
      "required": true
    },
    {
      "key": "period",
      "label": "工期",
      "type": "text",
      "required": true,
      "placeholder": "2026-04-01 〜 2026-09-30"
    }
  ],
  "checks": [
    {
      "type": "minLen",
      "n": 120,
      "msg": "要旨が短すぎます。工程・体制・安全対策の3点は書いてください"
    },
    {
      "type": "sentenceLen",
      "max": 100,
      "msg": "1文が100字を超えています。読み手は現場です。切ってください"
    },
    {
      "type": "needWords",
      "words": [
        "安全",
        "危険",
        "KY",
        "リスク"
      ],
      "any": true,
      "msg": "安全に関する記述が見当たりません"
    },
    {
      "type": "needNumber",
      "msg": "人員数・工期・数量などの数字がありません"
    },
    {
      "type": "banWords",
      "words": [
        "適宜",
        "適切に",
        "適時"
      ],
      "msg": "「適宜」「適切に」は現場で解釈が割れます。具体的に書いてください"
    }
  ],
  "routes": [
    {
      "name": "大型工事(5000万円以上)",
      "when": [
        [
          "amount",
          ">=",
          5000
        ]
      ],
      "steps": [
        "現場代理人",
        "安全管理",
        "工事部長",
        "役員"
      ]
    },
    {
      "name": "高所・重機あり",
      "when": [
        [
          "risk",
          "==",
          "あり"
        ]
      ],
      "steps": [
        "現場代理人",
        "安全管理",
        "工事部長"
      ]
    },
    {
      "name": "通常",
      "when": [],
      "steps": [
        "現場代理人",
        "工事部長"
      ]
    }
  ],
  "roles": [
    "現場代理人",
    "安全管理",
    "工事部長",
    "役員"
  ],
  "samples": [
    {
      "subject": "パークサイドビル 外壁改修工事",
      "counterparty": "株式会社パークサイド管理",
      "body": "外壁タイルの浮き部分を打診調査のうえ、部分張替えと全面再塗装を行います。工期は6か月、常用5名体制で、足場の組立解体は専門業者2社に分離発注します。高所作業となるため、朝礼時のKY活動を毎日実施し、墜落制止用器具の装着を作業開始前に相互確認します。近隣への粉塵対策として防音シートを二重に張り、土曜の作業は9時開始とします。",
      "fields": {
        "amount": "3200",
        "risk": "あり",
        "period": "2026-04-01 〜 2026-09-30"
      }
    },
    {
      "subject": "南口ロータリー 舗装打替え工事",
      "counterparty": "市川市 道路交通課",
      "fields": {
        "amount": "1450",
        "risk": "なし",
        "period": "2026-05-10 〜 2026-07-20"
      },
      "body": "既設アスファルトを切削したうえで、路盤の不陸を整正してから打替えを行います。常用4名体制、工期は10週間です。歩行者の動線を確保するため夜間施工とし、片側交互通行の保安要員を2名配置します。安全対策として、作業帯の出入口にセンサー式の回転灯を設置します。"
    },
    {
      "subject": "みなと物流センター 新築工事",
      "counterparty": "イータ物流株式会社",
      "fields": {
        "amount": "9800",
        "risk": "あり",
        "period": "2026-06-01 〜 2027-03-31"
      },
      "body": "鉄骨造3階建の物流センターを新築します。工期は10か月、常用12名体制で、鉄骨建方は専門業者へ分離発注します。高所作業と重機作業が重なるため、建方期間中は誘導員を2名専任で配置し、朝礼時のKY活動を毎日実施します。近隣小学校の通学路に面するため、登校時間帯の7時30分から8時30分は車両の出入りを停止します。"
    }
  ]
}