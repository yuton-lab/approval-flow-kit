{
  "id": "recruiting",
  "name": "人材紹介 / 推薦文の承認",
  "summary": "候補者を企業へ推薦する前に、推薦文を営業・上長の順で確認します。ブラインド送付では伏せる情報が増えるため、確認する人も増えます。",
  "terms": {
    "request": "推薦",
    "subject": "候補者",
    "counterparty": "推薦先企業",
    "body": "推薦文"
  },
  "fields": [
    { "key": "job", "label": "求人(職種)", "type": "text", "required": true, "placeholder": "法人営業" },
    { "key": "mode", "label": "送付種別", "type": "select", "options": ["通常推薦", "ブラインド送付"], "required": true },
    { "key": "raCheck", "label": "企業担当の確認", "type": "select", "options": ["必要", "不要"], "required": true }
  ],
  "checks": [
    { "type": "sentences", "min": 3, "max": 7, "msg": "3〜7文に収めてください。長いと読まれず、短いと判断材料になりません" },
    { "type": "sentenceLen", "max": 80, "msg": "1文が80字を超えています。切ってください" },
    { "type": "needNumber", "msg": "実績を裏付ける数字(達成率・件数・期間・人数など)がありません" },
    { "type": "banWords", "words": ["非常に", "大変", "豊富な", "確かな", "抜群"], "msg": "裏付けのない強調語が入っています" },
    { "type": "maxWordCount", "words": ["ものの", "一方で", "ながら", "ではありますが"], "n": 2, "msg": "逆接が多く、主張がぼやけています" }
  ],
  "routes": [
    { "name": "ブラインド送付", "when": [["mode", "==", "ブラインド送付"]], "steps": ["営業担当", "企業担当", "チームリーダー"] },
    { "name": "企業担当の確認あり", "when": [["raCheck", "==", "必要"]], "steps": ["営業担当", "企業担当"] },
    { "name": "通常", "when": [], "steps": ["営業担当", "チームリーダー"] }
  ],
  "roles": ["営業担当", "企業担当", "チームリーダー"],
  "sample": {
    "subject": "K様",
    "counterparty": "ベータ商事株式会社",
    "body": "法人営業として3年、新規開拓を担当されていました。年間目標の達成率は平均118%で、担当件数は月40件前後です。うち約2割を継続契約につなげています。後輩3名の育成も担当されていました。裁量の大きい環境を希望されており、貴社の事業内容と合致すると考え推薦いたします。",
    "fields": { "job": "法人営業", "mode": "通常推薦", "raCheck": "不要" }
  }
}
