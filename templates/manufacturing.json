{
  "id": "manufacturing",
  "name": "製造 / 設計変更申請の承認",
  "summary": "量産中の製品に手を入れる前の申請です。安全や法規に関わる変更と、客先支給図がある変更では、通る人が変わります。",
  "slaDays": 3,
  "terms": {
    "request": "設計変更",
    "subject": "対象品番",
    "counterparty": "客先",
    "body": "変更内容と理由"
  },
  "fields": [
    {
      "key": "safety",
      "label": "安全・法規への影響",
      "type": "select",
      "options": [
        "なし",
        "あり"
      ],
      "required": true
    },
    {
      "key": "customerDrawing",
      "label": "客先支給図の変更",
      "type": "select",
      "options": [
        "なし",
        "あり"
      ],
      "required": true
    },
    {
      "key": "lot",
      "label": "適用ロット",
      "type": "text",
      "required": true,
      "placeholder": "2026年5月生産分から"
    }
  ],
  "checks": [
    {
      "type": "needWords",
      "words": [
        "現状",
        "変更後"
      ],
      "any": false,
      "msg": "「現状」と「変更後」を対比で書いてください。差分が読み取れません"
    },
    {
      "type": "needNumber",
      "msg": "寸法・公差・数量などの数字がありません"
    },
    {
      "type": "minLen",
      "n": 100,
      "msg": "理由が書かれていない可能性があります。なぜ変えるのかを明記してください"
    },
    {
      "type": "banWords",
      "words": [
        "念のため",
        "とりあえず"
      ],
      "msg": "変更理由が曖昧です。判断の根拠を書いてください"
    }
  ],
  "routes": [
    {
      "name": "安全・法規に影響あり",
      "when": [
        [
          "safety",
          "==",
          "あり"
        ]
      ],
      "steps": [
        "設計課長",
        "品質保証",
        "製造部長",
        "技術担当役員"
      ]
    },
    {
      "name": "客先支給図の変更",
      "when": [
        [
          "customerDrawing",
          "==",
          "あり"
        ]
      ],
      "steps": [
        "設計課長",
        "品質保証",
        "営業窓口"
      ]
    },
    {
      "name": "通常",
      "when": [],
      "steps": [
        "設計課長",
        "製造部長"
      ]
    }
  ],
  "roles": [
    "設計課長",
    "品質保証",
    "製造部長",
    "営業窓口",
    "技術担当役員"
  ],
  "samples": [
    {
      "subject": "BR-4120 ブラケット",
      "counterparty": "シータ精機株式会社",
      "body": "現状は板厚2.0mmのSPCCで、曲げR3.0としています。組立工程で曲げ部に微小クラックが月あたり4件発生しており、原因は最小曲げ半径の不足と判断しました。変更後は板厚を1.8mmに下げ、曲げRを4.0に広げます。強度計算では安全率が2.4から2.2に下がりますが、社内基準の2.0は満たします。2026年5月生産分から適用します。",
      "fields": {
        "safety": "なし",
        "customerDrawing": "あり",
        "lot": "2026年5月生産分から"
      }
    },
    {
      "subject": "SH-2207 シャフト",
      "counterparty": "カッパ機械株式会社",
      "fields": {
        "safety": "あり",
        "customerDrawing": "なし",
        "lot": "2026年7月生産分から"
      },
      "body": "現状は焼入れ後の研磨を1工程で行っており、表面粗さがRa0.8で安定しません。搬送時の振動で微細な打痕が生じ、月2件の返品が発生しています。変更後は粗研磨と仕上研磨の2工程に分け、工程間の搬送をパレット化します。回転部品のため安全確認が必要と判断し、品質保証の確認を経てから適用します。2026年7月生産分から適用します。"
    },
    {
      "subject": "CV-0880 カバー",
      "counterparty": "シータ精機株式会社",
      "fields": {
        "safety": "なし",
        "customerDrawing": "なし",
        "lot": "2026年6月生産分から"
      },
      "body": "現状はビス4本で固定していますが、組立時間が1台あたり90秒かかっています。変更後はスナップフィット2箇所とビス2本に変更し、45秒に短縮します。保持力は試験で180Nを確認しており、要求値150Nを満たします。"
    }
  ]
}