{
  "id": "care",
  "name": "介護 / ケアプラン(居宅サービス計画)の承認",
  "summary": "利用者ごとの計画を、サービス提供責任者から管理者まで確認します。医療的ケアや区分変更を含む計画は、看護職が加わります。",
  "terms": {
    "request": "ケアプラン",
    "subject": "利用者",
    "counterparty": "居宅介護支援事業所",
    "body": "総合的な援助の方針"
  },
  "fields": [
    { "key": "medical", "label": "医療的ケアの有無", "type": "select", "options": ["なし", "あり"], "required": true },
    { "key": "change", "label": "要介護度の区分変更", "type": "select", "options": ["なし", "あり"], "required": true },
    { "key": "meeting", "label": "担当者会議の実施日", "type": "text", "required": true, "placeholder": "2026-09-05" }
  ],
  "checks": [
    { "type": "needWords", "words": ["本人", "ご本人"], "any": true, "msg": "本人の意向が書かれていません。家族の意向だけで組まれていないか確認してください" },
    { "type": "sentenceLen", "max": 90, "msg": "1文が90字を超えています。利用者・家族も読む書類です" },
    { "type": "banWords", "words": ["問題行動", "徘徊", "痴呆"], "msg": "本人と家族が読む書類です。この語は使わないでください" },
    { "type": "minLen", "n": 100, "msg": "方針が短すぎます。目標と、そのための支援内容まで書いてください" }
  ],
  "routes": [
    { "name": "医療的ケアあり", "when": [["medical", "==", "あり"]], "steps": ["サービス提供責任者", "看護職員", "管理者"] },
    { "name": "区分変更あり", "when": [["change", "==", "あり"]], "steps": ["サービス提供責任者", "主任ケアマネジャー", "管理者"] },
    { "name": "通常", "when": [], "steps": ["サービス提供責任者", "管理者"] }
  ],
  "roles": ["サービス提供責任者", "看護職員", "主任ケアマネジャー", "管理者"],
  "sample": {
    "subject": "M様(要介護2)",
    "counterparty": "みどり居宅介護支援事業所",
    "body": "ご本人は「自分の足で買い物に行きたい」と話されています。転倒への不安から外出の機会が週1回まで減っており、下肢筋力の低下が見られます。週2回の通所リハビリで歩行訓練を継続し、3か月後に屋外歩行を付き添いなしで500m行えることを目標とします。ご家族は日中不在のため、服薬確認を訪問介護で週3回実施します。",
    "fields": { "medical": "なし", "change": "なし", "meeting": "2026-09-05" }
  }
}
