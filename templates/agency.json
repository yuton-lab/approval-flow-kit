{
  "id": "agency",
  "name": "広告 / 入稿クリエイティブの承認",
  "summary": "媒体に出す前の表現チェックです。健康食品・化粧品や、ランキング・No.1表示を含む案件は、法務が入ります。",
  "slaDays": 1,
  "terms": {
    "request": "入稿",
    "subject": "案件名",
    "counterparty": "クライアント",
    "body": "コピー・表現案"
  },
  "fields": [
    {
      "key": "category",
      "label": "商材カテゴリ",
      "type": "select",
      "options": [
        "一般",
        "健康食品・化粧品",
        "金融"
      ],
      "required": true
    },
    {
      "key": "ranking",
      "label": "No.1・ランキング表示",
      "type": "select",
      "options": [
        "なし",
        "あり"
      ],
      "required": true
    },
    {
      "key": "media",
      "label": "出稿媒体",
      "type": "text",
      "required": true,
      "placeholder": "Web / 交通広告"
    }
  ],
  "checks": [
    {
      "type": "banWords",
      "words": [
        "完治",
        "治る",
        "絶対",
        "必ず痩せ",
        "永久",
        "100%"
      ],
      "msg": "断定・効能の表現です。媒体審査で戻ります"
    },
    {
      "type": "banWords",
      "words": [
        "業界初",
        "日本初",
        "No.1",
        "ナンバーワン"
      ],
      "msg": "優良誤認の対象です。使うなら調査の出典を添えてください"
    },
    {
      "type": "sentenceLen",
      "max": 60,
      "msg": "1文が60字を超えています。コピーとして長すぎます"
    },
    {
      "type": "maxLen",
      "n": 600,
      "msg": "全体が長すぎます。入稿枠に収まりません"
    }
  ],
  "routes": [
    {
      "name": "健康食品・化粧品",
      "when": [
        [
          "category",
          "==",
          "健康食品・化粧品"
        ]
      ],
      "steps": [
        "クリエイティブディレクター",
        "法務",
        "アカウント"
      ]
    },
    {
      "name": "No.1・ランキング表示あり",
      "when": [
        [
          "ranking",
          "==",
          "あり"
        ]
      ],
      "steps": [
        "クリエイティブディレクター",
        "法務",
        "アカウント"
      ]
    },
    {
      "name": "金融",
      "when": [
        [
          "category",
          "==",
          "金融"
        ]
      ],
      "steps": [
        "クリエイティブディレクター",
        "法務"
      ]
    },
    {
      "name": "通常",
      "when": [],
      "steps": [
        "クリエイティブディレクター",
        "アカウント"
      ]
    }
  ],
  "roles": [
    "クリエイティブディレクター",
    "法務",
    "アカウント"
  ],
  "samples": [
    {
      "subject": "秋の新生活キャンペーン バナー6本",
      "counterparty": "株式会社カッパ",
      "body": "毎朝の5分が、夜のねむりを変える。\n忙しい人ほど、朝の光を浴びていません。\n起きてすぐの散歩を3日続けた人の72%が「寝つきが良くなった」と回答しました。\n今日から始める人に、初回限定の1週間分をお届けします。",
      "fields": {
        "category": "健康食品・化粧品",
        "ranking": "なし",
        "media": "Web / 交通広告"
      }
    },
    {
      "subject": "冬のボーナス訴求 LP改修",
      "counterparty": "株式会社ラムダ",
      "fields": {
        "category": "金融",
        "ranking": "なし",
        "media": "Web"
      },
      "body": "そのボーナス、置いたままですか。\n普通預金に眠るお金は、1年で目減りしていきます。\n毎月1万円から始められる積立を、手数料なしでご用意しました。\n投資信託は元本保証ではありません。"
    },
    {
      "subject": "春の入学応援 交通広告",
      "counterparty": "株式会社ミュー",
      "fields": {
        "category": "一般",
        "ranking": "あり",
        "media": "交通広告"
      },
      "body": "入学準備、うちが日本初です。\nランドセルの軽さでNo.1をいただきました。\n6年間、絶対に壊れない設計です。\n春の入学フェア、開催中。"
    }
  ]
}